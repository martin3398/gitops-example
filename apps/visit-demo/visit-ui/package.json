{
  "name": "visit-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client && npm run build:assets",
    "build:client": "esbuild src/client.tsx --bundle --platform=browser --format=esm --minify --define:process.env.NODE_ENV='\"production\"' --outfile=dist/client.bundle.js",
    "build:assets": "cp src/template.html dist/template.html && cp src/styles/app.css dist/app.css",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.15.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "^0.28.0",
    "typescript": "5.8.2"
  }
}
