aws_region = "eu-central-1"

project_name = "gitops-showcase"
environment  = "dev"

vpc_cidr             = "10.42.0.0/16"
private_subnet_cidrs = ["10.42.10.0/24", "10.42.20.0/24", "10.42.30.0/24"]
public_subnet_cidr   = "10.42.100.0/24"

enable_public_k8s_api = true
lb_public_subnet_cidrs = ["10.42.101.0/24", "10.42.102.0/24"]

enable_public_ingress = true
ingress_allowed_cidrs = ["0.0.0.0/0"]
ingress_nodeport_http = 30080
# ingress_nodeport_https is intentionally omitted in examples
# (HTTPS/certificate management is out of scope for this AWS lab phase)

allowed_admin_cidrs = ["203.0.113.10/32"]
enable_ssh_from_admin_cidrs = false

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.large"
root_volume_size_gb         = 40

# Optional:
# ssh_key_name = "your-keypair-name"
# ami_id       = "ami-xxxxxxxxxxxxxxxxx"
